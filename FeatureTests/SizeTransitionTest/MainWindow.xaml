<Window x:Class="SizeTransitionTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SizeTransitionTest"
        mc:Ignorable="d"
        xmlns:ws="https://schemas.elecho.dev/wpfsuite"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <ToggleButton x:Name="toggle"
                          Content="Toggle"
                          IsChecked="True"/>
            <ws:VisibilityTransitioner IsOpen="{Binding ElementName=toggle,Path=IsChecked}"
                                       Duration="0:0:1"
                                       HorizontalAlignment="Left"
                                       Orientation="Horizontal">
                <Border>
                    <Border.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF6096DA"/>
                            <GradientStop Color="#FF511313" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Width="400" Height="400">

                    </TextBlock>
                </Border>
            </ws:VisibilityTransitioner>
        </StackPanel>
    </Grid>
</Window>
